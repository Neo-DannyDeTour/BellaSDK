[sub_resource type="Shader" id="Shader_drop"]
code = "shader_type spatial;
render_mode blend_add, cull_disabled, unshaded, shadows_disabled;

uniform vec4 core_color : source_color = vec4(1.0, 1.0, 1.0, 1.0);
uniform vec4 inner_color : source_color = vec4(1.0, 0.15, 0.35, 1.0);
uniform vec4 outer_color : source_color = vec4(0.85, 0.02, 0.05, 1.0);

void vertex() {
	float taper = mix(1.0, 0.12, pow(clamp(UV.y, 0.0, 1.0), 0.7));
	VERTEX.xz *= taper;
}

void fragment() {
	float ndotv = clamp(abs(dot(NORMAL, VIEW)), 0.0, 1.0);
	float fade = smoothstep(0.0, 0.08, UV.y) * smoothstep(1.0, 0.85, UV.y);
	float core = pow(ndotv, 16.0) * 8.0;
	float inner = pow(ndotv, 4.0) * 4.0;
	float outer = pow(ndotv, 1.5) * 2.0;
	ALBEDO = (core_color.rgb * core) + (inner_color.rgb * inner) + (outer_color.rgb * outer);
	ALPHA = clamp(core + inner + outer, 0.0, 1.0) * fade;
}
"

