#define PI 3.14159265359

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D input_data_image;
layout(binding = 1) uniform sampler2D input_color_image;
layout(rgba16f, binding = 2) uniform restrict writeonly image2D reflections_sample;
layout(binding = 3) uniform Sampler2DMSAA input_screen_image;
layout(rgba16f, binding = 4) uniform restrict Image2DMSAA output_screen_image;
layout(binding = 5) uniform Sampler2DMSAA depth_image;

layout(binding = 6, std140) uniform uniformBuffer {
    GenericData data;
} genericData;

layout(binding = 7, std140) uniform LightsBuffer {
    DirectionalLight directionalLights[4];
    PointLight pointLights[128];
    PointEffector pointEffectors[64];
};

layout(binding = 8, std140) uniform SceneDataBlock {
    SceneData data;
    SceneData prev_data;
} scene_data_block;

void sampleAtmospherics(
    vec3 curPos,
    float atmosphericHeight,
    float distanceTraveled,
    float Rayleighscaleheight,
    float Miescaleheight,
    vec3 RayleighScatteringCoef,
    float MieScatteringCoef,
    float atmosphericDensity,
    float density,
    inout vec3 totalRlh,
    inout vec3 totalMie,
    inout float iOdRlh,
    inout float iOdMie)
{
    float iHeight = max(curPos.y, 0.0) / max(atmosphericHeight, 1.0);
    float odStepRlh = exp(-iHeight * (atmosphericHeight / Rayleighscaleheight)) * distanceTraveled;
    float odStepMie = exp(-iHeight * (atmosphericHeight / Miescaleheight)) * distanceTraveled;
    iOdRlh += odStepRlh;
    iOdMie += odStepMie;

    vec3 opticalDepth = MieScatteringCoef * (iOdMie + Miescaleheight) + RayleighScatteringCoef * (iOdRlh + Rayleighscaleheight);
    vec3 attn = exp(-opticalDepth) * atmosphericDensity * (1.0 - clamp(iHeight, 0.0, 1.0));

    float transmittance = max(1.0 - density, 0.0);
    totalRlh += odStepRlh * attn * transmittance;
    totalMie += odStepMie * attn * transmittance;
}

vec4 sampleAllAtmospherics(
    vec3 worldPos,
    vec3 rayDirection,
    float linear_depth,
    float highestDensityDistance,
    float density,
    float stepDistance,
    float stepCount,
    float atmosphericDensity,
    vec3 sunDirection,
    vec3 sunlightColor,
    vec3 ambientLight)
{
    vec3 totalRlh = vec3(0.0);
    vec3 totalMie = vec3(0.0);
    float iOdRlh = 0.0;
    float iOdMie = 0.0;

    const float atmosphericHeight = 40000.0;
    const vec3 RayleighScatteringCoef = vec3(5.5e-6, 13.0e-6, 22.4e-6);
    const float Rayleighscaleheight = 8000.0;
    const float MieScatteringCoef = 21e-6;
    const float Miescaleheight = 1200.0;
    const float MiePreferredDirection = 0.758;

    float mu = clamp(dot(rayDirection, sunDirection), -1.0, 1.0);
    float mumu = mu * mu;
    float gg = MiePreferredDirection * MiePreferredDirection;

    float mieDenom = max(pow(1.0 + gg - 2.0 * mu * MiePreferredDirection, 1.5), 0.0001);
    float pMie = (3.0 / (8.0 * PI)) * ((1.0 - gg) * (mumu + 1.0)) / (mieDenom * (2.0 + gg));

    vec3 curPos = worldPos;
    float traveledDistance = 0.0;
    float currentWeight = 0.0;
    float sampleCount = 0.0;
    float maxSteps = clamp(stepCount, 1.0, 8.0);

    for (float i = 0.0; i < maxSteps; i += 1.0) {
        traveledDistance = stepDistance * (i + 1.0);
        currentWeight = density * (1.0 - clamp((highestDensityDistance - traveledDistance) / max(stepDistance, 0.001), 0.0, 1.0));

        if (traveledDistance > linear_depth || currentWeight >= 1.0) {
            traveledDistance -= stepDistance;
            currentWeight = 1.0 - clamp((linear_depth - traveledDistance) / max(stepDistance, 0.001), 0.0, 1.0);
            sampleAtmospherics(curPos, atmosphericHeight, stepDistance, Rayleighscaleheight, Miescaleheight, RayleighScatteringCoef, MieScatteringCoef, atmosphericDensity, currentWeight, totalRlh, totalMie, iOdRlh, iOdMie);
            sampleCount += 1.0;
            break;
        }

        sampleCount += 1.0;
        curPos = worldPos + rayDirection * traveledDistance;
        sampleAtmospherics(curPos, atmosphericHeight, stepDistance, Rayleighscaleheight, Miescaleheight, RayleighScatteringCoef, MieScatteringCoef, atmosphericDensity, currentWeight, totalRlh, totalMie, iOdRlh, iOdMie);
    }

    float validSampleCount = max(sampleCount, 1.0);
    vec3 atmospherics = 22.0 * (ambientLight * RayleighScatteringCoef * totalRlh + pMie * MieScatteringCoef * sunlightColor * totalMie) / validSampleCount;
    float AtmosphericsDistancePower = clamp(length(RayleighScatteringCoef * totalRlh + MieScatteringCoef * totalMie), 0.0, 1.0);

    return vec4(max(atmospherics, vec3(0.0)), AtmosphericsDistancePower);
}

void sampleBilateralData(vec2 uv, float targetLinearDepth, vec2 lowresTexelSize, out vec4 outColor, out vec4 outData) {
    vec2 pos = uv / lowresTexelSize - 0.5;
    vec2 f = fract(pos);
    vec2 base = (floor(pos) + 0.5) * lowresTexelSize;

    vec2 offsets[4] = vec2[](
        vec2(0.0, 0.0),
        vec2(lowresTexelSize.x, 0.0),
        vec2(0.0, lowresTexelSize.y),
        vec2(lowresTexelSize.x, lowresTexelSize.y)
    );

    float bilinearWeights[4] = float[](
        (1.0 - f.x) * (1.0 - f.y),
        f.x * (1.0 - f.y),
        (1.0 - f.x) * f.y,
        f.x * f.y
    );

    vec4 accumColor = vec4(0.0);
    vec4 accumData = vec4(0.0);
    float totalWeight = 0.0;

    for (int i = 0; i < 4; i++) {
        vec2 sUV = clamp(base + offsets[i], lowresTexelSize * 0.5, vec2(1.0) - lowresTexelSize * 0.5);
        vec4 dataSample = texture(input_data_image, sUV);
        vec4 colSample = texture(input_color_image, sUV);

        float sampleDepth = dataSample.g;
        float depthDiff = abs(sampleDepth - targetLinearDepth);
        float depthWeight = 1.0 / (1.0 + depthDiff * 0.005);
        float w = bilinearWeights[i] * depthWeight;

        accumColor += colSample * w;
        accumData += dataSample * w;
        totalWeight += w;
    }

    if (totalWeight > 0.0001) {
        outColor = accumColor / totalWeight;
        outData = accumData / totalWeight;
    } else {
        outColor = texture(input_color_image, uv);
        outData = texture(input_data_image, uv);
    }
}

vec4 sampleBlurredColor(vec2 uv, vec2 lowresTexelSize, float blurRadius) {
    vec4 centerCol = texture(input_color_image, uv);
    if (blurRadius <= 0.001) {
        return centerCol;
    }

    vec2 blurOffsets[4] = vec2[](
        vec2(0.0, 1.0) * blurRadius * lowresTexelSize,
        vec2(0.0, -1.0) * blurRadius * lowresTexelSize,
        vec2(1.0, 0.0) * blurRadius * lowresTexelSize,
        vec2(-1.0, 0.0) * blurRadius * lowresTexelSize
    );

    vec4 col = centerCol * 0.4;
    for (int i = 0; i < 4; i++) {
        vec2 sUV = clamp(uv + blurOffsets[i], lowresTexelSize * 0.5, vec2(1.0) - lowresTexelSize * 0.5);
        col += texture(input_color_image, sUV) * 0.15;
    }
    return col;
}

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lowres_size = ivec2(genericData.data.raster_size);

    int resolutionScale = max(int(genericData.data.resolutionscale), 1);
    ivec2 size = lowres_size * resolutionScale;

    if (uv.x >= size.x || uv.y >= size.y) {
        return;
    }

    vec2 depthUV = (vec2(uv) + 0.5) / vec2(size);
    vec2 lowresTexelSize = 1.0 / vec2(lowres_size);

    vec4 clipPos = vec4(depthUV * 2.0 - 1.0, 1.0, 1.0);
    vec4 viewPos = genericData.data.cam_inv_projection * clipPos;
    viewPos.xyz /= max(viewPos.w, 0.00001);

    vec3 rd_world = normalize(mat3(genericData.data.cam_inv_view) * normalize(viewPos.xyz));
    vec3 rayOrigin = genericData.data.cam_inv_view[3].xyz;

    float minstep = genericData.data.min_step_distance;
    float maxstep = genericData.data.max_step_distance;
    float maxTheoreticalStep = genericData.data.max_step_count * maxstep;
    float blurPower = genericData.data.blurPower;

    float baseDepth = texelFetchMSAA(depth_image, uv, 0).r;
    vec4 baseView = genericData.data.cam_inv_projection * vec4(depthUV * 2.0 - 1.0, baseDepth, 1.0);
    baseView.xyz /= max(baseView.w, 0.00001);
    float baseLinearDepth = (baseDepth <= 0.00001) ? 1000000.0 : length(baseView.xyz);

    vec4 currentAccumulation = vec4(0.0);
    vec4 currentColorData = vec4(0.0);

    if (resolutionScale > 1) {
        sampleBilateralData(depthUV, baseLinearDepth, lowresTexelSize, currentAccumulation, currentColorData);
    } else {
        currentAccumulation = texture(input_color_image, depthUV);
        currentColorData = texture(input_data_image, depthUV);
    }

    if (blurPower > 0.0) {
        float blurFade = 1.0 - clamp(currentColorData.b / max(maxTheoreticalStep, 1.0), 0.0, 1.0);
        currentAccumulation = sampleBlurredColor(depthUV, lowresTexelSize, blurPower * blurFade);
    }

    float initialdistanceSample = currentColorData.r;
    float traveledDistance = currentColorData.g;
    float cloudDensity = clamp(currentAccumulation.a, 0.0, 1.0);

    int sampleCount = textureSamplesMSAA(depth_image);
    vec4 averageColor = vec4(0.0);

    for (int sampleIdx = 0; sampleIdx < sampleCount; ++sampleIdx) {
        float depth = texelFetchMSAA(depth_image, uv, sampleIdx).r;
        vec4 view = genericData.data.cam_inv_projection * vec4(depthUV * 2.0 - 1.0, depth, 1.0);
        view.xyz /= max(view.w, 0.00001);
        float linear_depth = (depth <= 0.00001) ? 1000000.0 : length(view.xyz);

        float density = cloudDensity;
        if (initialdistanceSample > linear_depth) {
            density = 0.0;
        } else if (traveledDistance > linear_depth) {
            density *= clamp((linear_depth - initialdistanceSample) / max(traveledDistance - initialdistanceSample, 0.001), 0.0, 1.0);
        }

        vec4 screenColor = texelFetchMSAA(input_screen_image, uv, sampleIdx);

        if (density > 0.0) {
            screenColor.rgb = mix(screenColor.rgb, currentAccumulation.rgb, density);
        }

        screenColor.rgb = max(screenColor.rgb, vec3(0.0));
        imageStoreMSAA(output_screen_image, uv, sampleIdx, screenColor);
        averageColor.rgb += screenColor.rgb;
    }

    averageColor /= float(max(sampleCount, 1));

    if (uv.x % resolutionScale == 0 && uv.y % resolutionScale == 0) {
        ivec2 lowresCoord = uv / resolutionScale;
        if (lowresCoord.x < lowres_size.x && lowresCoord.y < lowres_size.y) {
            imageStore(reflections_sample, lowresCoord, vec4(averageColor.rgb, traveledDistance));
        }
    }
}
