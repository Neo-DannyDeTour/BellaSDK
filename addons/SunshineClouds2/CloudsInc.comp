};

// Safe Math Helpers
float safe_remap(float value, float min1, float max1, float min2, float max2) {
    float diff = max1 - min1;
    if (abs(diff) < 0.00001) {
        return min2;
    }
    return min2 + (clamp(value, min(min1, max1), max(min1, max1)) - min1) * (max2 - min2) / diff;
}

float safe_HenyeyGreenstein(float g, float costh) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * costh, 0.0001);
    return (1.0 - g2) / (4.0 * PI * denom * sqrt(denom));
}

bool intersectHorizontalSlab(vec3 origin, vec3 dir, float floorY, float ceilingY, out float tMin, out float tMax) {
    if (abs(dir.y) < 0.00001) {
        if (origin.y >= floorY && origin.y <= ceilingY) {
            tMin = 0.0;
            tMax = 1000000.0;
            return true;
        }
        tMin = 0.0;
        tMax = 0.0;
        return false;
    }

    float t0 = (floorY - origin.y) / dir.y;
    float t1 = (ceilingY - origin.y) / dir.y;

    tMin = max(min(t0, t1), 0.0);
    tMax = max(t0, t1);

    return tMax > tMin;
}

