[sub_resource type="Shader" id="Shader_g0xi4"]
code = "shader_type spatial;
render_mode cull_front;

// The maximum permanent twist applied to the mesh geometry.
// Set this to the OPPOSITE of your GDScript's max_twist_degrees.
// If your script rotates the pivot by -90, this must be 90.
uniform float permanent_twist_degrees = 90.0;

// The length of the hallway mesh.
uniform float hallway_length = 10.0;

// Offsets the math so the twist starts exactly at the entrance.
// Since the mesh is 10m long and centered at Z = -5, its local top is at +5.
uniform float z_offset = 5.0;

void vertex() {
    // Calculate progress from 0.0 (entrance) to 1.0 (exit)
    float progress = clamp((-VERTEX.z + z_offset) / hallway_length, 0.0, 1.0);

    // Calculate the static twist angle for this specific vertex
    float angle = radians(permanent_twist_degrees) * progress;

    // Rotate the X and Y coordinates around the Z axis
    float cos_a = cos(angle);
    float sin_a = sin(angle);

    float new_x = VERTEX.x * cos_a - VERTEX.y * sin_a;
    float new_y = VERTEX.x * sin_a + VERTEX.y * cos_a;

    VERTEX.x = new_x;
    VERTEX.y = new_y;

    // Rotate the normals so lighting accurately reflects off the twisted walls
    float norm_x = NORMAL.x * cos_a - NORMAL.y * sin_a;
    float norm_y = NORMAL.x * sin_a + NORMAL.y * cos_a;

    NORMAL.x = norm_x;
    NORMAL.y = norm_y;
}"

