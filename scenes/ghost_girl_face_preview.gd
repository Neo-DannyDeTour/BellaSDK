## Studio close-up preview comparing GhostGirl GLB blendshapes and Humanizer facial AnimationTree.
class_name GhostGirlFacePreview
extends Node3D

## Emitted when the active rig display mode cycles via the H key.
signal display_mode_changed(mode: RigDisplayMode)

## Rig visibility and layout modes cycled with the H key.
enum RigDisplayMode {
	## Shows only the GhostGirl GLB blendshape character centered in frame.
	BLENDSHAPE_GLB,
	## Shows only the runtime Humanizer character centered in frame.
	HUMANIZER,
	## Shows both GhostGirl GLB and Humanizer side-by-side for visual comparison.
	SIDE_BY_SIDE,
}

## Output folder where R-key ARKit facial recordings are saved as `.res` clips.
const SAVE_DIR: String = "res://assets/animations/ghost_girl_facial"
## Autoload singleton node name providing Live Link Face UDP streaming on port 11111.
const ARKIT_AUTOLOAD_NAME: String = "ARKitSingleton"
## Humanizer target key generated by [code]import_ghost_girl_humanizer.gd[/code].
const HUMANIZER_TARGET_KEY: String = "custom_ghost_girl_anime"
## Humanizer skeleton rig preset matching [code]face_animation_tree.tscn[/code].
const HUMANIZER_RIG_NAME: String = "default-RETARGETED"
## Humanizer skin material name registered under [code]Body-Default[/code].
const HUMANIZER_SKIN_MATERIAL: String = "ghost_girl_anime_skin"
## Ordered GhostGirl Humanizer equipment IDs attached at runtime.
const HUMANIZER_EQUIPMENT_IDS: Array[String] = [
	"GhostGirl_Hair_Cards",
	"GhostGirl_Hood",
	"GhostGirl_Cape",
	"GhostGirl_CropTop",
	"GhostGirl_Skirt",
	"GhostGirl_Gloves",
	"GhostGirl_Boots",
	"GhostGirl_Eye_L",
	"GhostGirl_Eye_R",
	"GhostGirl_Eyelashes",
]
## Ordered lip-sync viseme cycle stepped by pressing the V key.
const VISEME_CYCLE: Array[StringName] = [&"aa", &"ee", &"ih", &"oh", &"ou"]
## Key-to-expression preset lookup table for hotkeys 1 through 6.
const EXPRESSION_KEYS: Dictionary[int, StringName] = {
	KEY_1: &"neutral",
	KEY_2: &"happy",
	KEY_3: &"surprised",
	KEY_4: &"angry",
	KEY_5: &"sad",
	KEY_6: &"blink",
}
## Display labels corresponding to [enum RigDisplayMode] values.
const MODE_LABELS: Dictionary[RigDisplayMode, String] = {
	RigDisplayMode.BLENDSHAPE_GLB: "Blendshape GLB",
	RigDisplayMode.HUMANIZER: "Humanizer",
	RigDisplayMode.SIDE_BY_SIDE: "Side-by-Side Both",
}
## Angular speed in radians per second for the gaze orbit marker.
const ORBIT_SPEED_RAD: float = 1.6
## Horizontal gaze orbit amplitude in meters in front of GhostGirl.
const ORBIT_RADIUS_X: float = 0.44
## Vertical gaze orbit amplitude in meters around eye level.
const ORBIT_RADIUS_Y: float = 0.14
## Base eye height in meters for GhostGirl gaze orbit and camera framing.
const ORBIT_CENTER_Y: float = 1.44
## Base Z distance in meters in front of GhostGirl (-Z forward).
const ORBIT_BASE_Z: float = -0.82
## Depth modulation amplitude in meters along Z during gaze orbit.
const ORBIT_DEPTH_Z: float = 0.08
## Horizontal offset in meters used in [constant RigDisplayMode.SIDE_BY_SIDE].
const SIDE_BY_SIDE_OFFSET_X: float = 0.28
## Default exported facial animation clip played via the P key.
const DEFAULT_FACIAL_CLIP: Animation = preload(
	"res://assets/animations/ghost_girl_facial/ghostgirl_test_video.tres"
)
## AnimationLibrary name registered on the facial clip [AnimationPlayer].
const FACIAL_CLIP_LIB: StringName = &"facial_clips"
## Animation key name used inside [constant FACIAL_CLIP_LIB].
const FACIAL_CLIP_NAME: StringName = &"performance"
## Full library-prefixed animation identifier played by [member _facial_player].
const FACIAL_CLIP_FULL_NAME: StringName = &"facial_clips/performance"
## Camera local position for single-character framing.
const CAMERA_POS_SINGLE: Vector3 = Vector3(0.0, 1.45, -0.82)
## Camera local position pulled back for side-by-side framing.
const CAMERA_POS_BOTH: Vector3 = Vector3(0.0, 1.45, -1.18)

## Facial [Animation] clip played on GhostGirl GLB when pressing the P key.
@export var facial_clip: Animation = DEFAULT_FACIAL_CLIP

## Currently selected rig display mode.
var _display_mode: RigDisplayMode = RigDisplayMode.BLENDSHAPE_GLB
## True while continuous gaze orbit updates [member _gaze_orbit_target].
var _gaze_orbit_active: bool = false
## True while listening to [code]ARKitSingleton[/code] UDP frames on port 11111.
var _arkit_live_active: bool = false
## True while driving the built-in synthetic 61-float ARKit sweep.
var _synth_sweep_active: bool = false
## Current phase angle in radians for the gaze orbit trajectory.
var _orbit_phase: float = 0.0
## Current elapsed phase in seconds for the synthetic ARKit sweep.
var _synth_phase: float = 0.0
## Monotonic frame counter stamped into synthetic [ARKitPacket] payloads.
var _synth_frame_counter: int = 0
## Pre-allocated 61-float buffer reused for zero-allocation synthetic packet generation.
var _synth_weights: PackedFloat32Array = PackedFloat32Array()
## Active index inside [constant VISEME_CYCLE], or -1 when displaying an expression preset.
var _viseme_index: int = -1
## Active mode/expression text fragment shown in the HUD status line.
var _mode_status_text: String = "Expr: neutral"
## Runtime Humanizer [CharacterBody3D] counterpart built in [method _ready].
var _human_body: CharacterBody3D = null
## Default forward [Marker3D] look target attached to [member _human_body].
var _human_default_look_target: Marker3D = null
## Facial rig controller attached to [member _human_body].
var _human_face_rig: FaceRigController = null
## Facial clip recorder toggled by pressing the R key.
var _recorder: ARKitRecorder = ARKitRecorder.new()
## Incremental take counter appended to saved facial animation clip names.
var _take_counter: int = 0
## Resource path of the most recently saved facial animation `.res` clip.
var _last_saved_path: String = ""
## True while [member _facial_player] is playing [member facial_clip].
var _clip_playing: bool = false
## Dedicated [AnimationPlayer] attached to [member _ghost_girl] for `.tres` facial clips.
var _facial_player: AnimationPlayer = null

## Instanced GhostGirl [NpcActor] character in the preview studio.
@onready var _ghost_girl: NpcActor = $GhostGirl
## Facial rig controller child inside [member _ghost_girl].
@onready var _glb_face_rig: FaceRigController = $GhostGirl/FaceRigController
## Studio camera framed on GhostGirl's face.
@onready var _camera: Camera3D = $Camera3D
## Moving [Marker3D] assigned as look target while gaze orbit is active.
@onready var _gaze_orbit_target: Marker3D = $GazeOrbitTarget
## Status line [Label] inside the preview HUD.
@onready var _status_label: Label = $PreviewHUD/HudPanel/HudMargin/HudStack/StatusLabel


## Builds the Humanizer counterpart, initializes buffers, and sleeps [method _process] at idle.
func _ready() -> void:
	set_process(false)
	set_physics_process(false)
	_synth_weights.resize(61)
	_synth_weights.fill(0.0)

	assert(is_instance_valid(_ghost_girl), "GhostGirlFacePreview requires GhostGirl node.")
	assert(is_instance_valid(_glb_face_rig), "GhostGirlFacePreview requires FaceRigController.")
	assert(is_instance_valid(_camera), "GhostGirlFacePreview requires Camera3D.")
	assert(is_instance_valid(_gaze_orbit_target), "GhostGirlFacePreview requires GazeOrbitTarget.")
	assert(is_instance_valid(_status_label), "GhostGirlFacePreview requires StatusLabel.")

	_setup_facial_clip_player()
	_build_humanizer_counterpart()
	_apply_display_mode()
	_refresh_status_label()


## Disconnects [code]ARKitSingleton[/code] listeners and stops UDP streaming on tree exit.
func _exit_tree() -> void:
	if is_instance_valid(_facial_player) and _facial_player.is_playing():
		_facial_player.stop()
	_clip_playing = false
	var autoload: Node = _get_arkit_autoload()
	if is_instance_valid(autoload):
		if (
			autoload.has_signal("frame_received")
			and autoload.is_connected("frame_received", _on_arkit_frame_received)
		):
			autoload.disconnect("frame_received", _on_arkit_frame_received)
		if _arkit_live_active and autoload.has_signal("stop_server"):
			autoload.emit_signal("stop_server")
	_arkit_live_active = false
	_synth_sweep_active = false
	_gaze_orbit_active = false


## Drives gaze orbit and/or synthetic 61-float ARKit sweep only while those modes are active.
func _process(delta: float) -> void:
	if _gaze_orbit_active:
		_orbit_phase = fmod(_orbit_phase + delta * ORBIT_SPEED_RAD, TAU)
		_gaze_orbit_target.global_position = Vector3(
			sin(_orbit_phase) * ORBIT_RADIUS_X,
			ORBIT_CENTER_Y + sin(_orbit_phase * 2.0) * ORBIT_RADIUS_Y,
			ORBIT_BASE_Z + cos(_orbit_phase) * ORBIT_DEPTH_Z,
		)

	if _synth_sweep_active:
		_synth_phase += delta
		step_synthetic_arkit_frame(_synth_phase)


## Handles expressions (1-6), visemes (V), gaze (G), rig mode (H), ARKit (A/T), and record (R).
func _unhandled_input(event: InputEvent) -> void:
	if not (event is InputEventKey):
		return
	var key_event: InputEventKey = event as InputEventKey
	if not key_event.pressed or key_event.echo:
		return

	var code: int = key_event.keycode
	if EXPRESSION_KEYS.has(code):
		_apply_expression_preset(EXPRESSION_KEYS[code])
		get_viewport().set_input_as_handled()
		return

	if code == KEY_V:
		_step_viseme_cycle()
		get_viewport().set_input_as_handled()
		return

	if code == KEY_G:
		_toggle_gaze_orbit()
		get_viewport().set_input_as_handled()
		return

	if code == KEY_H:
		cycle_display_mode()
		get_viewport().set_input_as_handled()
		return

	if code == KEY_A:
		_toggle_arkit_live()
		get_viewport().set_input_as_handled()
		return

	if code == KEY_T:
		_toggle_synthetic_sweep()
		get_viewport().set_input_as_handled()
		return

	if code == KEY_R:
		_toggle_recording()
		get_viewport().set_input_as_handled()
		return

	if code == KEY_P:
		_toggle_facial_clip()
		get_viewport().set_input_as_handled()


## Cycles through [enum RigDisplayMode] options and returns the new active mode.
func cycle_display_mode() -> RigDisplayMode:
	var next_idx: int = (int(_display_mode) + 1) % 3
	var next_mode: RigDisplayMode = RigDisplayMode.BLENDSHAPE_GLB
	if next_idx == 1:
		next_mode = RigDisplayMode.HUMANIZER
	elif next_idx == 2:
		next_mode = RigDisplayMode.SIDE_BY_SIDE
	set_display_mode(next_mode)
	return _display_mode


## Sets the active [enum RigDisplayMode] and updates node visibility, spacing, and framing.
func set_display_mode(mode: RigDisplayMode) -> void:
	_display_mode = mode
	_apply_display_mode()
	_refresh_status_label()
	display_mode_changed.emit(_display_mode)
	print("GhostGirlFacePreview: display_mode -> ", _get_mode_label(_display_mode))


## Generates one real 61-float [ARKitPacket] frame, applies weights to rigs, and records if active.
func step_synthetic_arkit_frame(phase_sec: float = -1.0) -> ARKitPacket:
	var phase: float = phase_sec if phase_sec >= 0.0 else _synth_phase
	_synth_frame_counter += 1
	_fill_synthetic_weights(phase)

	var raw_bytes: PackedByteArray = (
		ARKitPacket
		. build_packet_bytes(
			"SYNTH-GHOSTGIRL",
			"GhostGirlSweep",
			_synth_frame_counter,
			60,
			_synth_weights,
		)
	)
	var packet: ARKitPacket = ARKitPacket.new(raw_bytes)
	if packet.is_valid:
		_apply_arkit_to_rigs(packet.blendshapes_array)
		if _recorder.is_recording():
			_recorder.record_packet(packet)
			_refresh_status_label()
	return packet


## Returns the currently active [enum RigDisplayMode].
func get_display_mode() -> RigDisplayMode:
	return _display_mode


## Returns the instanced GhostGirl GLB [NpcActor] node.
func get_ghost_girl() -> NpcActor:
	return _ghost_girl


## Returns the [FaceRigController] attached to the GhostGirl GLB actor.
func get_glb_face_rig() -> FaceRigController:
	return _glb_face_rig


## Returns the runtime-generated Humanizer [CharacterBody3D] counterpart.
func get_humanizer_body() -> CharacterBody3D:
	return _human_body


## Returns the [FaceRigController] driving the Humanizer [AnimationTree] counterpart.
func get_humanizer_face_rig() -> FaceRigController:
	return _human_face_rig


## Returns the active [ARKitRecorder] owned by this preview scene.
func get_recorder() -> ARKitRecorder:
	return _recorder


## Returns the resource path of the last saved facial animation clip.
func get_last_saved_path() -> String:
	return _last_saved_path


## Returns true when continuous gaze orbit is enabled.
func is_gaze_orbit_active() -> bool:
	return _gaze_orbit_active


## Returns true when live [code]ARKitSingleton[/code] UDP streaming is enabled.
func is_arkit_live_active() -> bool:
	return _arkit_live_active


## Returns true when the synthetic 61-float [ARKitPacket] sweep is running.
func is_synthetic_sweep_active() -> bool:
	return _synth_sweep_active


## Returns true while [member facial_clip] is actively playing on GhostGirl GLB.
func is_facial_clip_playing() -> bool:
	return _clip_playing


## Returns the [AnimationPlayer] driving exported `.tres` facial clips on GhostGirl GLB.
func get_facial_clip_player() -> AnimationPlayer:
	return _facial_player


## Builds the runtime Humanizer GhostGirl counterpart and attaches a [FaceRigController].
func _build_humanizer_counterpart() -> void:
	if HumanizerRegistry.rigs.is_empty():
		HumanizerRegistry._get_rigs()
	if (
		HumanizerRegistry.equipment.is_empty()
		or not HumanizerRegistry.equipment.has("GhostGirl_Hair_Cards")
		or not HumanizerTargetService.data.has(HUMANIZER_TARGET_KEY)
	):
		HumanizerRegistry.load_all()

	if (
		not HumanizerRegistry.rigs.has(HUMANIZER_RIG_NAME)
		or not HumanizerTargetService.data.has(HUMANIZER_TARGET_KEY)
	):
		push_warning("GhostGirlFacePreview: Humanizer GhostGirl assets not registered.")
		return

	var config: HumanConfig = HumanConfig.new()
	config.rig = HUMANIZER_RIG_NAME
	config.skin_color = Color.WHITE
	config.hair_color = Color.WHITE
	config.set_targets({HUMANIZER_TARGET_KEY: 1.0})
	config.add_equipment(HumanizerEquipment.new("Body-Default", HUMANIZER_SKIN_MATERIAL))
	for equip_id: String in HUMANIZER_EQUIPMENT_IDS:
		if HumanizerRegistry.equipment.has(equip_id):
			config.add_equipment(HumanizerEquipment.new(equip_id, equip_id))

	var humanizer: Humanizer = Humanizer.new()
	humanizer.load_config_async(config)
	var body_raw: Variant = humanizer.get_CharacterBody3D(false)
	if not (body_raw is CharacterBody3D):
		push_warning("GhostGirlFacePreview: Humanizer failed to build CharacterBody3D.")
		return

	_human_body = body_raw as CharacterBody3D
	_human_body.name = "HumanizerGhostGirl"
	_human_body.set_physics_process(false)
	_human_body.collision_layer = 0
	_human_body.collision_mask = 0
	# Humanizer meshes face +Z; rotate PI around Y to face -Z camera alongside GhostGirl GLB.
	_human_body.rotation.y = PI
	add_child(_human_body)

	_human_default_look_target = Marker3D.new()
	_human_default_look_target.name = "LookTarget"
	_human_default_look_target.position = Vector3(0.0, ORBIT_CENTER_Y, 3.0)
	_human_body.add_child(_human_default_look_target)

	var anim_tree: AnimationTree = _human_body.get_node_or_null(^"AnimationTree") as AnimationTree
	_human_face_rig = FaceRigController.new()
	_human_face_rig.name = "FaceRigController"
	_human_face_rig.model_root = _human_body
	_human_face_rig.look_target = _human_default_look_target
	_human_face_rig.face_animation_tree = anim_tree
	_human_face_rig.head_mesh_name = ""
	_human_face_rig.eyelash_mesh_name = ""
	_human_body.add_child(_human_face_rig)


## Applies visibility, horizontal offsets, and camera framing for [member _display_mode].
func _apply_display_mode() -> void:
	if _display_mode == RigDisplayMode.BLENDSHAPE_GLB:
		_ghost_girl.visible = true
		_ghost_girl.position = Vector3.ZERO
		if is_instance_valid(_human_body):
			_human_body.visible = false
			_human_body.position = Vector3.ZERO
		_camera.position = CAMERA_POS_SINGLE
	elif _display_mode == RigDisplayMode.HUMANIZER:
		_ghost_girl.visible = false
		_ghost_girl.position = Vector3.ZERO
		if is_instance_valid(_human_body):
			_human_body.visible = true
			_human_body.position = Vector3.ZERO
		_camera.position = CAMERA_POS_SINGLE
	else:
		_ghost_girl.visible = true
		_ghost_girl.position = Vector3(-SIDE_BY_SIDE_OFFSET_X, 0.0, 0.0)
		if is_instance_valid(_human_body):
			_human_body.visible = true
			_human_body.position = Vector3(SIDE_BY_SIDE_OFFSET_X, 0.0, 0.0)
		_camera.position = CAMERA_POS_BOTH


## Applies an expression preset to both GhostGirl GLB and Humanizer controllers.
func _apply_expression_preset(expr_name: StringName) -> void:
	if _clip_playing:
		_stop_facial_clip()
	_viseme_index = -1
	_glb_face_rig.set_expression(expr_name)
	if is_instance_valid(_human_face_rig):
		_human_face_rig.set_expression(expr_name)
	_mode_status_text = "Expr: " + String(expr_name)
	_refresh_status_label()


## Cycles through [constant VISEME_CYCLE] on both facial controllers.
func _step_viseme_cycle() -> void:
	if _clip_playing:
		_stop_facial_clip()
	_viseme_index = (_viseme_index + 1) % VISEME_CYCLE.size()
	var viseme_name: StringName = VISEME_CYCLE[_viseme_index]
	_glb_face_rig.set_viseme(viseme_name, 1.0)
	if is_instance_valid(_human_face_rig):
		_human_face_rig.set_viseme(viseme_name, 1.0)
	_mode_status_text = "Viseme: " + String(viseme_name)
	_refresh_status_label()


## Toggles gaze orbit tracking on both GhostGirl GLB and Humanizer rigs.
func _toggle_gaze_orbit() -> void:
	_gaze_orbit_active = not _gaze_orbit_active
	if _gaze_orbit_active:
		_orbit_phase = 0.0
		_ghost_girl.set_look_target(_gaze_orbit_target)
		if is_instance_valid(_human_face_rig):
			_human_face_rig.look_target = _gaze_orbit_target
	else:
		_ghost_girl.set_look_target(null)
		if is_instance_valid(_human_face_rig):
			_human_face_rig.look_target = _human_default_look_target
	_sync_process_state()
	_refresh_status_label()
	print("GhostGirlFacePreview: gaze_orbit=", _gaze_orbit_active)


## Toggles live UDP facial streaming from [code]ARKitSingleton[/code] on port 11111.
func _toggle_arkit_live() -> void:
	_arkit_live_active = not _arkit_live_active
	var autoload: Node = _get_arkit_autoload()
	if _arkit_live_active:
		if _clip_playing:
			_stop_facial_clip()
		_synth_sweep_active = false
		if is_instance_valid(autoload):
			if (
				autoload.has_signal("frame_received")
				and not autoload.is_connected("frame_received", _on_arkit_frame_received)
			):
				autoload.connect("frame_received", _on_arkit_frame_received)
			if autoload.has_signal("start_server"):
				autoload.emit_signal("start_server")
		_mode_status_text = "ARKit Live (11111)"
	else:
		if is_instance_valid(autoload):
			if (
				autoload.has_signal("frame_received")
				and autoload.is_connected("frame_received", _on_arkit_frame_received)
			):
				autoload.disconnect("frame_received", _on_arkit_frame_received)
			if autoload.has_signal("stop_server"):
				autoload.emit_signal("stop_server")
		_mode_status_text = "Expr: " + String(_glb_face_rig.get_current_expression())
	_sync_eye_look_for_arkit()
	_sync_process_state()
	_refresh_status_label()
	print("GhostGirlFacePreview: arkit_live=", _arkit_live_active)


## Toggles the built-in synthetic 61-float [ARKitPacket] sweep.
func _toggle_synthetic_sweep() -> void:
	_synth_sweep_active = not _synth_sweep_active
	if _synth_sweep_active:
		if _clip_playing:
			_stop_facial_clip()
		if _arkit_live_active:
			_toggle_arkit_live()
		_synth_phase = 0.0
		_mode_status_text = "Synthetic ARKit Sweep"
	else:
		_mode_status_text = "Expr: " + String(_glb_face_rig.get_current_expression())
	_sync_eye_look_for_arkit()
	_sync_process_state()
	_refresh_status_label()
	print("GhostGirlFacePreview: synthetic_sweep=", _synth_sweep_active)


## Starts or stops [member _recorder] and saves `.res` clips to [constant SAVE_DIR].
func _toggle_recording() -> void:
	if not _recorder.is_recording():
		var active_ctrl: FaceRigController = _get_primary_controller()
		if is_instance_valid(active_ctrl):
			_recorder.configure_from_controller(active_ctrl)
		_recorder.record_bones = true
		_recorder.start_recording()
		print("GhostGirlFacePreview: recording started")
	else:
		var anim: Animation = _recorder.stop_recording()
		_take_counter += 1
		var clip_name: String = "ghost_girl_take_%02d" % _take_counter
		_last_saved_path = _recorder.save_animation(anim, SAVE_DIR, clip_name)
		print("GhostGirlFacePreview: recording saved -> ", _last_saved_path)
	_refresh_status_label()


## Attaches a dedicated [AnimationPlayer] under [member _ghost_girl] for `.tres` facial clips.
func _setup_facial_clip_player() -> void:
	_facial_player = AnimationPlayer.new()
	_facial_player.name = "FacialClipPlayer"
	_facial_player.root_node = NodePath("..")
	_ghost_girl.add_child(_facial_player)
	_facial_player.animation_finished.connect(_on_facial_clip_finished)


## Toggles playback of [member facial_clip] on GhostGirl GLB, pausing look-at and auto-blink.
func _toggle_facial_clip() -> void:
	if _clip_playing:
		_stop_facial_clip()
		return
	if not is_instance_valid(facial_clip) or not is_instance_valid(_facial_player):
		push_warning("GhostGirlFacePreview: no facial_clip assigned.")
		return

	if _arkit_live_active:
		_toggle_arkit_live()
	if _synth_sweep_active:
		_toggle_synthetic_sweep()

	if _facial_player.has_animation_library(FACIAL_CLIP_LIB):
		_facial_player.remove_animation_library(FACIAL_CLIP_LIB)
	var lib: AnimationLibrary = AnimationLibrary.new()
	lib.add_animation(FACIAL_CLIP_NAME, facial_clip)
	_facial_player.add_animation_library(FACIAL_CLIP_LIB, lib)

	_ghost_girl.look_at_enabled = false
	_glb_face_rig.set_eye_look_enabled(false)
	_glb_face_rig.auto_blink_enabled = false
	_facial_player.play(FACIAL_CLIP_FULL_NAME)
	_clip_playing = true
	_mode_status_text = "Clip: " + facial_clip.resource_name
	_refresh_status_label()
	print("GhostGirlFacePreview: playing facial_clip -> ", facial_clip.resource_path)


## Stops [member _facial_player] and restores GhostGirl look-at, auto-blink, and neutral pose.
func _stop_facial_clip() -> void:
	if is_instance_valid(_facial_player) and _facial_player.is_playing():
		_facial_player.stop()
	_clip_playing = false
	_ghost_girl.look_at_enabled = true
	_glb_face_rig.auto_blink_enabled = true
	_glb_face_rig.set_expression(&"neutral", 0.0)
	_sync_eye_look_for_arkit()
	_mode_status_text = "Expr: " + String(_glb_face_rig.get_current_expression())
	_refresh_status_label()
	print("GhostGirlFacePreview: facial_clip stopped")


## Restores rig state when [member _facial_player] finishes playing [member facial_clip].
func _on_facial_clip_finished(_anim_name: StringName) -> void:
	if _clip_playing:
		_stop_facial_clip()


## Applies incoming live UDP [param packet] frames to both rigs and active recording.
func _on_arkit_frame_received(_subject: ARKitSubject, packet: ARKitPacket) -> void:
	if not is_instance_valid(packet) or not packet.is_valid:
		return
	_apply_arkit_to_rigs(packet.blendshapes_array)
	if _recorder.is_recording():
		_recorder.record_packet(packet)
		_refresh_status_label()


## Applies 61-float ARKit channel weights to both GLB and Humanizer controllers.
func _apply_arkit_to_rigs(weights: PackedFloat32Array) -> void:
	_glb_face_rig.apply_arkit_weights(weights)
	if is_instance_valid(_human_face_rig):
		_human_face_rig.apply_arkit_weights(weights)


## Populates [member _synth_weights] for a smooth 61-channel test sweep at [param phase].
func _fill_synthetic_weights(phase: float) -> void:
	_synth_weights.fill(0.0)
	var blink_pulse: float = pow(maxf(0.0, sin(phase * 2.1)), 12.0)
	_synth_weights[ARKitServer.BlendShape.EYE_BLINK_LEFT] = blink_pulse
	_synth_weights[ARKitServer.BlendShape.EYE_BLINK_RIGHT] = blink_pulse
	_synth_weights[ARKitServer.BlendShape.JAW_OPEN] = 0.35 + 0.35 * sin(phase * 1.7)
	_synth_weights[ARKitServer.BlendShape.MOUTH_SMILE_LEFT] = 0.5 + 0.5 * sin(phase * 1.3)
	_synth_weights[ARKitServer.BlendShape.MOUTH_SMILE_RIGHT] = 0.5 + 0.5 * sin(phase * 1.3)
	_synth_weights[ARKitServer.BlendShape.BROW_INNER_UP] = 0.5 + 0.5 * cos(phase * 1.1)
	_synth_weights[ARKitServer.BlendShape.CHEEK_PUFF] = maxf(0.0, sin(phase * 0.9)) * 0.45
	_synth_weights[ARKitServer.BlendShape.HEAD_YAW] = 0.25 * sin(phase * 0.8)
	_synth_weights[ARKitServer.BlendShape.HEAD_PITCH] = 0.14 * sin(phase * 1.2)
	_synth_weights[ARKitServer.BlendShape.HEAD_ROLL] = 0.10 * cos(phase * 0.7)


## Disables procedural eye look-at while ARKit streaming drives eye gaze channels directly.
func _sync_eye_look_for_arkit() -> void:
	var arkit_driving: bool = _arkit_live_active or _synth_sweep_active
	var enable_look: bool = not arkit_driving
	_glb_face_rig.set_eye_look_enabled(enable_look)
	if is_instance_valid(_human_face_rig):
		_human_face_rig.set_eye_look_enabled(enable_look)


## Activates [method _process] only while gaze orbit or synthetic sweep is running.
func _sync_process_state() -> void:
	set_process(_gaze_orbit_active or _synth_sweep_active)


## Returns the primary [FaceRigController] matching [member _display_mode] for recording.
func _get_primary_controller() -> FaceRigController:
	if _display_mode == RigDisplayMode.HUMANIZER and is_instance_valid(_human_face_rig):
		return _human_face_rig
	return _glb_face_rig


## Looks up the [code]ARKitSingleton[/code] autoload node on the active [SceneTree] root.
func _get_arkit_autoload() -> Node:
	if not is_inside_tree():
		return null
	var tree: SceneTree = get_tree()
	if not is_instance_valid(tree) or not is_instance_valid(tree.root):
		return null
	return tree.root.get_node_or_null(NodePath(ARKIT_AUTOLOAD_NAME))


## Returns human-readable display text for [param mode].
func _get_mode_label(mode: RigDisplayMode) -> String:
	var raw_label: Variant = MODE_LABELS.get(mode, "Blendshape GLB")
	return raw_label if raw_label is String else "Blendshape GLB"


## Updates [member _status_label] with current rig mode, pose, gaze, ARKit, and recorder state.
func _refresh_status_label() -> void:
	if not is_instance_valid(_status_label):
		return
	var gaze_text: String = "Orbit" if _gaze_orbit_active else "Camera"
	var arkit_text: String = (
		"UDP" if _arkit_live_active else ("Synth" if _synth_sweep_active else "Off")
	)
	var rec_text: String = (
		"Rec(%d)" % _recorder.get_frame_count()
		if _recorder.is_recording()
		else ("Saved" if not _last_saved_path.is_empty() else "Idle")
	)
	_status_label.text = (
		"Mode: %s | %s | Gaze: %s | ARKit: %s | Rec: %s"
		% [_get_mode_label(_display_mode), _mode_status_text, gaze_text, arkit_text, rec_text]
	)
