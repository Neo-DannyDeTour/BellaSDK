[sub_resource type="Shader" id="Shader_spark"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, blend_add, depth_draw_never, shadows_disabled;

uniform vec4 core_color : source_color = vec4(0.88, 0.98, 1.0, 1.0);
uniform vec4 ray_color : source_color = vec4(0.2, 0.72, 1.0, 1.0);
uniform float hdr_intensity : hint_range(1.0, 20.0) = 7.5;

varying float v_life;
varying float v_seed;

void vertex() {
	float c = cos(INSTANCE_CUSTOM.x);
	float s = sin(INSTANCE_CUSTOM.x);
	float sx = length(MODELVIEW_MATRIX[0].xyz);
	float sy = length(MODELVIEW_MATRIX[1].xyz);
	float sz = length(MODELVIEW_MATRIX[2].xyz);
	MODELVIEW_MATRIX = mat4(
		vec4(c * sx, s * sx, 0.0, 0.0),
		vec4(-s * sy, c * sy, 0.0, 0.0),
		vec4(0.0, 0.0, sz, 0.0),
		MODELVIEW_MATRIX[3]
	);
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	v_life = clamp(INSTANCE_CUSTOM.y, 0.0, 1.0);
	v_seed = INSTANCE_CUSTOM.x * 3.17 + MODELVIEW_MATRIX[3].x * 7.13 + MODELVIEW_MATRIX[3].y * 11.7;
}

void fragment() {
	vec2 p = (UV - vec2(0.5)) * 2.0;
	float r = length(p);
	float angle = atan(p.y, p.x);

	float core = exp(-r * r * 16.0);
	float halo = exp(-r * r * 5.0) * 0.4;
	float ray_a = pow(abs(cos(angle * 3.0 + v_seed + TIME * 14.0)), 7.0) * 0.7;
	float ray_b = pow(abs(sin(angle * 5.0 - v_seed * 1.7 - TIME * 19.0)), 11.0) * 0.6;
	float rays = (ray_a + ray_b) * smoothstep(0.95, 0.06, r);

	float radial_mask = smoothstep(0.98, 0.45, r);
	float life_fade = smoothstep(0.0, 0.1, v_life) * smoothstep(1.0, 0.65, v_life);
	float intensity = (core + halo + rays) * radial_mask * life_fade;

	vec3 rgb = mix(ray_color.rgb, core_color.rgb, clamp(core * 1.3, 0.0, 1.0)) * COLOR.rgb * hdr_intensity;
	ALBEDO = rgb;
	ALPHA = clamp(intensity * COLOR.a, 0.0, 1.0);
}
"

