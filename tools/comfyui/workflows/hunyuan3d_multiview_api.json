{
  "1": {
    "class_type": "Hy3DModelLoader",
    "inputs": {
      "model": "hunyuan3d-dit-v2-mv-fp16.safetensors",
      "attention_mode": "sdpa",
      "cublas_ops": false
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "front.png",
      "upload": "image"
    }
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "left.png",
      "upload": "image"
    }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "back.png",
      "upload": "image"
    }
  },
  "5": {
    "class_type": "Hy3DGenerateMeshMultiView",
    "inputs": {
      "pipeline": ["1", 0],
      "front": ["2", 0],
      "left": ["3", 0],
      "back": ["4", 0],
      "guidance_scale": 5.5,
      "steps": 30,
      "seed": 42,
      "scheduler": "FlowMatchEulerDiscreteScheduler"
    }
  },
  "6": {
    "class_type": "Hy3DVAEDecode",
    "inputs": {
      "vae": ["1", 1],
      "latents": ["5", 0],
      "box_v": 1.01,
      "octree_resolution": 384,
      "num_chunks": 8000,
      "mc_level": 0.0,
      "mc_algo": "mc",
      "enable_flash_vdm": true,
      "force_offload": true
    }
  },
  "7": {
    "class_type": "Hy3DPostprocessMesh",
    "inputs": {
      "trimesh": ["6", 0],
      "remove_floaters": true,
      "remove_degenerate_faces": true,
      "reduce_faces": true,
      "max_facenum": 50000,
      "smooth_normals": false
    }
  },
  "8": {
    "class_type": "Hy3DExportMesh",
    "inputs": {
      "trimesh": ["7", 0],
      "filename_prefix": "3D/Hy3D_mv",
      "file_format": "glb",
      "save_file": true
    }
  }
}
