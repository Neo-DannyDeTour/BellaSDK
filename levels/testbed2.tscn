[node name="Label3D32" type="Label3D" parent="Texts" unique_id=731050787 groups=["3d_text"]]
transform = Transform3D(3.059797e-07, 0, 1, 0, 1, 0, -1, 0, 3.059797e-07, -19.10282, 2.132581, 32.86971)
text = "What are you looking for?
Some meaning of life?
Movement is life/fundamental property
of all matter.
There is no end to our work.
We will always be unsatisfied
with the current state of things.
Keep grinding while you breathe.
Fake it till you make it
and when you make it -
\"The black belt represents not
the end, but the beginning, the
start of a never-ending journey
of discipline, work and the pursuit of an ever-higher
standard.”"

